# Production Environment Variables for CloudJiffy
# Update these values after creating your CloudJiffy environment

# Database - CloudJiffy PostgreSQL node connection
DATABASE_URL=postgres://webadmin:YOUR_DB_PASSWORD@node_id-postgres.cloudjiffy.net:5432/growthos_qr_reviews?sslmode=require

# Service port
PORT=8098

# Gemini AI API Key (for review suggestions)
OPENAI_API_KEY=AIzaSyBTrXU2C74jkZTSJALMTgYYwm0IprNtt7I
OPENAI_MODEL=gemini-2.5-flash

# IMPORTANT: Set this to your actual CloudJiffy domain
# This is used in QR code generation — the URL encoded in QR images
QR_BASE_URL=https://your-env-name.cloudjiffy.net
