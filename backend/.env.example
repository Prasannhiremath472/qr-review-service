# Either set DATABASE_URL directly, or leave it unset and set
# DATABASE_USER / DATABASE_PASSWORD / DATABASE_NAME (+ optional DATABASE_HOST,
# defaults to "localhost") instead — useful on hosts like Hostinger that
# inject those three separately and don't allow a custom DATABASE_URL.
DATABASE_URL="mysql://user:password@localhost:3306/qr_reviews"
PORT=8098
LOG_LEVEL=debug
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
QR_BASE_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
