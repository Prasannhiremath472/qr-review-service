{
  "name": "qr-review-backend",
  "version": "1.0.0",
  "description": "QR Review Service backend (Node.js + Express + mysql2)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node scripts/migrate.js",
