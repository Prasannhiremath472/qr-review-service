generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALESMAN
  OWNER
}

model User {
  id           String   @id @default(uuid()) @db.VarChar(36)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String   @default("") @db.VarChar(255)
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  shops Shop[]

  @@map("users")
}

model Shop {
  id             String     @id @default(uuid()) @db.VarChar(36)
  name           String     @db.VarChar(255)
  ownerName      String     @default("") @map("owner_name") @db.VarChar(255)
  businessType   String     @default("business") @map("business_type") @db.VarChar(100)
  city           String     @default("") @db.VarChar(100)
  reviewUrl      String     @map("review_url") @db.Text
  organizationId String?    @map("organization_id") @db.VarChar(36)
  ownerUserId    String?    @map("owner_user_id") @db.VarChar(36)
  owner          User?      @relation(fields: [ownerUserId], references: [id])
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at")

  qrCodes   QRCode[]
  feedbacks Feedback[]

  @@index([organizationId])
  @@index([ownerUserId])
  @@map("shops")
}

model QRCode {
  id        String    @id @db.VarChar(10)
  shopId    String?   @map("shop_id") @db.VarChar(36)
  shop      Shop?     @relation(fields: [shopId], references: [id])
  label     String    @default("") @db.VarChar(255)
  scanCount Int       @default(0) @map("scan_count")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  feedbacks Feedback[]

  @@index([shopId])
  @@map("qr_codes")
}

model Feedback {
  id        String   @id @default(uuid()) @db.VarChar(36)
  shopId    String   @map("shop_id") @db.VarChar(36)
  shop      Shop     @relation(fields: [shopId], references: [id])
  qrCodeId  String?  @map("qr_code_id") @db.VarChar(10)
  qrCode    QRCode?  @relation(fields: [qrCodeId], references: [id])
  rating    Int
  message   String   @default("") @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([shopId])
  @@index([qrCodeId])
  @@map("feedback")
}
